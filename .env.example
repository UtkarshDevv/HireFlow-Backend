# ── LLM (OpenRouter or OpenAI) ───────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=sk-...your-openai-key-here...
# OPENAI_MODEL=gpt-4o

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default, zero-setup):
DATABASE_URL=sqlite:///./ai_jobs.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/ai_jobs

# ── Job APIs ─────────────────────────────────────────────────────────────────
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
# RemoteOK — no key needed
# USAJobs — free, no key needed for basic access

# ── Authentication & Security ────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Admin Signup Email Alerts ────────────────────────────────────────────────
ADMIN_NOTIFICATION_EMAIL=your-email@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM_EMAIL=your-email@example.com
SMTP_FROM_NAME=HireFlow Career Platform

# ── App ──────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000
RESUMES_DIR=./resumes
